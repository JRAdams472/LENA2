# PostgreSQL (used by docker-compose db)
POSTGRES_USER=lena
POSTGRES_PASSWORD=change-me
POSTGRES_DB=lena

# Caddy site address.
#   :80            — local/dev HTTP only (default; ports 443 stay unused)
#   example.com    — production: Caddy serves HTTPS on 443, provisions a
#                    Let's Encrypt cert automatically, and redirects :80.
#                    The DNS record must already resolve to this host and
#                    ports 80+443 must be reachable from the internet —
#                    ACME challenges fail otherwise.
# Never use :443 alone (no SNI name = no certificate, TLS is dead).
CADDY_ADDR=:80

# Next.js public API URL (must match Caddy route)
NEXT_PUBLIC_API_BASE_URL=/graphql
NEXT_PUBLIC_GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com

# LENA2 API config
LENA_PORT=8080
LENA_LOG_LEVEL=info
LENA_DB_USER=lena_app
LENA_DB_PASSWORD=change-me
LENA_DATABASE_URL=postgres://lena_app:change-me@db:5432/lena?sslmode=disable
LENA_GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
LENA_AUTH_ISSUERS=https://accounts.google.com
# Audience list must be one entry per issuer (paired by position).
LENA_AUTH_AUDIENCES=your-google-client-id.apps.googleusercontent.com
LENA_CORS_ALLOWED_ORIGINS=http://localhost,http://localhost:3000
# Bootstrap admin: promoted to the 'admin' role on first sign-in.
# Use the issuer URL followed by a colon and the email, e.g.:
# LENA_ADMIN_EMAILS=https://accounts.google.com:you@example.com
# Protected admins can never be demoted or banned (comma-separated, issuer:email).
# LENA_PROTECTED_EMAILS=https://accounts.google.com:you@example.com
# Approval barrier: first-time sign-ins stay pending until an admin approves
# them (default true). The very first sign-in on a deployment with zero
# admins bootstraps as admin. Set false for dev/test stacks.
# LENA_REQUIRE_MEMBER_APPROVAL=true
# Trusted proxy CIDRs for X-Forwarded-For parsing. With the default compose
# topology (Caddy direct to internet) this must be exactly Caddy's pinned
# address — anything broader lets a compose-network peer spoof client IPs.
# LENA_TRUSTED_PROXY_CIDRS=172.31.0.10/32

# Rate limiting (per-minute budgets; <= 0 disables)
# LENA_GRAPHQL_RATE_LIMIT_PER_MINUTE=120
# LENA_GRAPHQL_RATE_LIMIT_BURST=20
# Per-request GraphQL execution deadline and field-resolution budget.
# LENA_GRAPHQL_TIMEOUT=10s
# AI-backed fields (askAssistant, suggest*) get their own deadline; raise it
# for slow providers, and keep HTTP_WRITE_TIMEOUT above it.
# LENA_GRAPHQL_AI_TIMEOUT=120s
# LENA_GRAPHQL_MAX_COST=100000
# LENA_IP_RATE_LIMIT_PER_MINUTE=300
# LENA_IP_RATE_LIMIT_BURST=60
# Global bucket for /auth/session/{provider}: bounds total outbound calls
# to provider token endpoints even when a flood spans many source IPs.
# LENA_AUTH_CODE_EXCHANGE_RATE_LIMIT_PER_MINUTE=60
# LENA_AUTH_CODE_EXCHANGE_RATE_LIMIT_BURST=20
# Introspection is admin-only by default; set true to disable it entirely.
# LENA_GRAPHQL_DISABLE_INTROSPECTION=false

# Idempotent mutations: replay completed responses for Idempotency-Key
# retries, and dedup byte-identical payloads inside the fallback window.
# LENA_IDEMPOTENCY_ENABLED=true
# LENA_IDEMPOTENCY_KEY_TTL=24h
# LENA_IDEMPOTENCY_AUTO_TTL=30s
# LENA_IDEMPOTENCY_IN_FLIGHT_TTL=150s
# LENA_IDEMPOTENCY_WAIT_TIMEOUT=30s

# Notification Manager: hourly reminder sweep, the server-local hour
# date-based reminders become due, and how far ahead expiring pantry
# items alert.
# LENA_NOTIFY_SWEEP_INTERVAL=1h
# LENA_NOTIFY_HOUR=8
# LENA_NOTIFY_EXPIRY_DAYS=3
# Mobile push delivery (LEN-17): "log" records would-be sends (default —
# the full pipeline runs credential-free); "fcm" sends through Firebase
# Cloud Messaging and needs a mounted service-account JSON.
# LENA_PUSH_PROVIDER=log
# LENA_PUSH_POLL_INTERVAL=5s
# LENA_PUSH_MAX_ATTEMPTS=5
# LENA_FCM_CREDENTIALS_FILE=/run/secrets/fcm-service-account.json
# Analytics-driven ranking: how often decayed selection scores rebuild, and
# the engagement half-life in days.
# LENA_ANALYTICS_DECAY_INTERVAL=6h
# LENA_ANALYTICS_HALF_LIFE_DAYS=90

# OpenTelemetry (empty endpoint disables trace export)
# LENA_OTEL_EXPORTER_OTLP_ENDPOINT=
# Set false when exporting to a TLS-enabled collector.
# LENA_OTEL_EXPORTER_OTLP_INSECURE=true

# Recipe OCR import (empty OLLAMA_URL disables the feature)
# LENA_OLLAMA_URL=http://ollama:11434
# LENA_OLLAMA_MODEL=qwen2.5:7b-instruct
# LENA_OLLAMA_TEMPERATURE=0.1
# LENA_OLLAMA_NUM_CTX=8192
# LENA_OLLAMA_VISION_MODEL=
# LENA_OCR_SERVICE_URL=http://ocr:8000
# LENA_OCR_CONFIDENCE_THRESHOLD=50
# Caps each call to the OCR sidecar; raise if large multi-page PDFs time out.
# LENA_OCR_TIMEOUT=20s
# Host ports for the containerized OCR/Ollama services when using the host tools.
# Change these if 8000 or 11434 are already in use on your machine.
# LENA_OCR_HOST_PORT=8000
# LENA_OLLAMA_HOST_PORT=11434
# Ollama runs CPU-only by default so the import/ai profiles work on any
# host. With an NVIDIA GPU + Container Toolkit, add -f docker-compose.gpu.yml
# to the compose invocation to reserve the device (no env toggle — compose
# can't conditionally include a deploy.reservations block).
# LENA_IMPORT_INBOX=./import/inbox
# LENA_RECIPE_SCAN_MAX_BYTES=20971520
# LENA_IMPORT_AUTO_ACCEPT_CONFIDENCE=0.92
# LENA_IMPORT_REVIEW_THRESHOLD=0.75
# LENA_IMPORT_WORKER_CONCURRENCY=1
# LENA_PROFANITY_EXTRA_TERMS=

# AI assistant (empty LENA_AI_PROVIDER disables the feature).
# Start Ollama for the assistant with the `ai` compose profile:
#   docker compose -f docker-compose.yml -f docker-compose.import.yml --profile ai up -d
# LENA_AI_PROVIDER=ollama
# LENA_AI_MODEL=
# LENA_AI_TEMPERATURE=0.2
# LENA_AI_NUM_CTX=8192
# LENA_AI_TIMEOUT=60s
# LENA_AI_MAX_TOOL_ROUNDS=5
# Semantic recipe search: recipe embeddings via a small Ollama embedding
# model. Enabled whenever LENA_OLLAMA_URL is set (or AI_PROVIDER=mock);
# the model must produce 768-dim vectors to match the schema column.
# LENA_AI_EMBED_MODEL=nomic-embed-text
# LENA_AI_EMBED_TIMEOUT=30s

# Instacart "shop this list" integration (empty key disables the feature;
# shopperProviders returns [] and the clients hide the button).
# Dev keys target connect.dev.instacart.tools; production keys use
# https://connect.instacart.com.
# LENA_INSTACART_API_KEY=
# LENA_INSTACART_BASE_URL=https://connect.dev.instacart.tools
# LENA_INSTACART_TIMEOUT=15s

# Sessions (empty disables refresh-token sessions — OIDC-only mode).
# Generate once: openssl rand -hex 32 (must be at least 32 bytes or the
# server refuses to start).
# LENA_SESSION_SECRET=
# LENA_SESSION_ACCESS_TTL=15m
# LENA_SESSION_REFRESH_TTL=720h

# Discord OAuth2 sign-in (empty disables). Register the app in the Discord
# Developer Portal; the redirect URI must match exactly. The MOBILE URI
# is the app's deep-link redirect — required before the mobile app's
# Discord button can complete sign-in.
# LENA_DISCORD_CLIENT_ID=
# LENA_DISCORD_CLIENT_SECRET=
# LENA_DISCORD_REDIRECT_URI=http://localhost/auth/discord/callback
# LENA_DISCORD_MOBILE_REDIRECT_URI=lena://oauth/discord

# Microsoft Entra sign-in (empty disables). Register an app in Entra;
# TENANT is "consumers" (personal accounts) or a tenant GUID — "common"
# and "organizations" are unsupported (templated issuer).
# LENA_MICROSOFT_CLIENT_ID=
# LENA_MICROSOFT_CLIENT_SECRET=
# LENA_MICROSOFT_TENANT=consumers
# LENA_MICROSOFT_REDIRECT_URI=http://localhost/auth/microsoft/callback
# LENA_MICROSOFT_MOBILE_REDIRECT_URI=lena://oauth/microsoft

# Facebook Login (OIDC) sign-in (empty disables). Register the app at
# developers.facebook.com; the redirect URI must match exactly.
# LENA_FACEBOOK_CLIENT_ID=
# LENA_FACEBOOK_CLIENT_SECRET=
# LENA_FACEBOOK_REDIRECT_URI=http://localhost/auth/facebook/callback
# LENA_FACEBOOK_MOBILE_REDIRECT_URI=lena://oauth/facebook

# Sign in with Apple (empty disables). CLIENT_ID is the Services ID for
# the web code exchange; BUNDLE_ID trusts the iOS app's native
# identityTokens as bearer credentials. The client_secret is minted
# server-side as a short-lived ES256 JWT from the .p8 key — the secret
# never lives in config.
# LENA_APPLE_CLIENT_ID=
# LENA_APPLE_REDIRECT_URI=https://lenaskitchen.app/auth/apple/callback
# LENA_APPLE_TEAM_ID=
# LENA_APPLE_KEY_ID=
# LENA_APPLE_PRIVATE_KEY_FILE=/run/secrets/apple-signin.p8
# LENA_APPLE_BUNDLE_ID=app.lenaskitchen.lena

# Public client ids exposed to the web bundle (provider buttons).
# NEXT_PUBLIC_APPLE_CLIENT_ID=
# NEXT_PUBLIC_DISCORD_CLIENT_ID=
# NEXT_PUBLIC_MICROSOFT_CLIENT_ID=
# NEXT_PUBLIC_MICROSOFT_TENANT=consumers
# NEXT_PUBLIC_FACEBOOK_CLIENT_ID=

# Mobile build-time dart-defines for the in-app provider flows (see
# clients/mobile/README.md):
# LENA_DISCORD_CLIENT_ID / LENA_MICROSOFT_CLIENT_ID / LENA_FACEBOOK_CLIENT_ID

# Optional centralized logging (docker-compose.logging.yml). Salted PBKDF
# hash of the Seq admin password — required when the overlay is enabled.
# SEQ_FIRSTRUN_ADMINPASSWORDHASH=

# Reference-data seed is opt-in: docker compose --profile seed up db-seed
