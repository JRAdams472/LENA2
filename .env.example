# PostgreSQL (used by docker-compose db)
POSTGRES_USER=lena
POSTGRES_PASSWORD=change-me
POSTGRES_DB=lena

# Caddy bind address (use :80 for local HTTP, :443 for TLS with a valid domain)
CADDY_ADDR=:80

# Next.js public API URL (must match Caddy route)
NEXT_PUBLIC_API_BASE_URL=/graphql
NEXT_PUBLIC_GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com

# LENA2 API config
LENA_PORT=8080
LENA_LOG_LEVEL=info
LENA_DATABASE_URL=postgres://lena:change-me@db:5432/lena?sslmode=disable
LENA_GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
LENA_AUTH_ISSUERS=https://accounts.google.com
LENA_AUTH_AUDIENCES=your-google-client-id.apps.googleusercontent.com
LENA_CORS_ALLOWED_ORIGINS=http://localhost,http://localhost:3000
