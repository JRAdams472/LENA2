# PostgreSQL (used by docker-compose db)
POSTGRES_USER=lena
POSTGRES_PASSWORD=change-me
POSTGRES_DB=lena

# Caddy bind address (use :80 for local HTTP, :443 for TLS with a valid domain)
CADDY_ADDR=:80

# Next.js public API URL (must match Caddy route)
NEXT_PUBLIC_API_BASE_URL=/graphql
NEXT_PUBLIC_GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com

# LENA2 API config
LENA_PORT=8080
LENA_LOG_LEVEL=info
LENA_DATABASE_URL=postgres://lena:change-me@db:5432/lena?sslmode=disable
LENA_GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
LENA_AUTH_ISSUERS=https://accounts.google.com
LENA_AUTH_AUDIENCES=your-google-client-id.apps.googleusercontent.com
LENA_CORS_ALLOWED_ORIGINS=http://localhost,http://localhost:3000
# Bootstrap admin: promoted to the 'admin' role on first sign-in.
# LENA_ADMIN_EMAILS=you@example.com
# Protected admins can never be demoted or banned (comma-separated).
# LENA_PROTECTED_EMAILS=you@example.com

# Rate limiting (per-minute budgets; <= 0 disables)
# LENA_GRAPHQL_RATE_LIMIT_PER_MINUTE=120
# LENA_GRAPHQL_RATE_LIMIT_BURST=20
# LENA_IP_RATE_LIMIT_PER_MINUTE=300
# LENA_IP_RATE_LIMIT_BURST=60

# OpenTelemetry (empty endpoint disables trace export)
# LENA_OTEL_EXPORTER_OTLP_ENDPOINT=
# Set false when exporting to a TLS-enabled collector.
# LENA_OTEL_EXPORTER_OTLP_INSECURE=true

# Recipe OCR import (empty OLLAMA_URL disables the feature)
# LENA_OLLAMA_URL=http://ollama:11434
# LENA_OLLAMA_MODEL=qwen2.5:7b-instruct
# LENA_OLLAMA_TEMPERATURE=0.1
# LENA_OLLAMA_NUM_CTX=8192
# LENA_OLLAMA_VISION_MODEL=
# LENA_OCR_SERVICE_URL=http://ocr:8000
# LENA_OCR_CONFIDENCE_THRESHOLD=50
# Host ports for the containerized OCR/Ollama services when using the host tools.
# Change these if 8000 or 11434 are already in use on your machine.
# LENA_OCR_HOST_PORT=8000
# LENA_OLLAMA_HOST_PORT=11434
# LENA_IMPORT_INBOX=./import/inbox
# LENA_RECIPE_SCAN_MAX_BYTES=20971520
# LENA_IMPORT_AUTO_ACCEPT_CONFIDENCE=0.92
# LENA_IMPORT_REVIEW_THRESHOLD=0.75
# LENA_IMPORT_WORKER_CONCURRENCY=1
# LENA_PROFANITY_EXTRA_TERMS=
