# In the intended deployment Caddy faces the internet directly: no upstream
# proxy is trusted, so an inbound X-Forwarded-For is never honored — Caddy
# rewrites it from the real peer before proxying and a client cannot spoof
# the IP the API's rate limiters key on.
#
# If an LB/CDN/private ingress is placed in front, re-add the global block
# scoped to that ingress's CIDR only, e.g.:
#   {
#       servers {
#           trusted_proxies static 10.0.0.0/8
#       }
#   }
{$CADDY_ADDR:-:80} {
    handle /graphql {
        reverse_proxy api:8080
    }

    handle /auth/* {
        reverse_proxy api:8080
    }

    handle /health {
        reverse_proxy api:8080
    }

    handle {
        reverse_proxy web:3000
    }

    header {
        -Server
        -X-Powered-By
        X-Content-Type-Options nosniff
        X-Frame-Options DENY
        Referrer-Policy strict-origin-when-cross-origin
        Permissions-Policy "camera=(), microphone=(), geolocation=(), interest-cohort=()"
        # CSP is owned by the web tier (clients/web/proxy.ts) — it issues a
        # per-request nonce instead of 'unsafe-inline'. Setting a static
        # policy here would shadow or conflict with that header.
        Strict-Transport-Security "max-age=31536000; includeSubDomains"
    }
}
