scalar Time
scalar Date

# Marks a field as requiring an authenticated admin. Enforced by the
# resolvers (requireAdmin); declared here so the contract is explicit.
directive @admin on FIELD_DEFINITION

# Persisted authorization roles on identity.users.
enum Role {
  member
  admin
}

# Catalog object classes tracked by analytics.
enum EntityType {
  item
  brand
  recipe
  bottle
  ingredient
}

# How the recipes query's `search` text is matched: keyword does a
# name-LIKE filter; semantic embeds the text and ranks by blended cosine
# distance + engagement (requires embeddings — see semanticSearchAvailable).
enum RecipeSearchMode {
  keyword
  semantic
}

# Where a recipe import sits in the staged pipeline
# (internal/app/recipeimport.Status).
enum RecipeImportStatus {
  pending
  processing
  ocred
  drafted
  reviewing
  ready
  profanity
  failed
  rejected
  persisted
}

# Why a recipe was recommended (analytics.recipe_recommendation.reason).
enum RecommendationReason {
  ingredient_overlap
  rating_recency
  collaborative_filtering
  category_affinity
  household_trending
}

# Moderation state shared by catalog items and brands.
enum ModerationStatus {
  pending
  approved
  rejected
}

# Mapping state of one draft item in a recipe-import review.
enum ReviewItemStatus {
  accepted
  suggested
  unmatched
}

# Whether an entity actually contains the allergen or only carries a
# cross-contamination advisory.
enum AllergenFlagKind {
  contains
  may_contain
}

# Whether a member's record is a medical allergy or a dietary
# restriction — warnings label the kind so the household can judge
# severity.
enum MemberAllergyKind {
  allergy
  dietary
}

type Query {
  me: User!
  brand(id: ID!): Brand
  brands(page: Int = 1, pageSize: Int = 25): BrandPage!
  searchBrands(term: String!, limit: Int = 20): [Brand!]!
  pendingBrands(page: Int = 1, pageSize: Int = 25): BrandPage! @admin
  frequentBrands(limit: Int = 10): [Brand!]!
  category(id: ID!): Category
  categories: [Category!]!
  flavorProfiles: [FlavorProfile!]!
  nutrientTypes: [NutrientType!]!
  item(id: ID!): Item
  items(page: Int = 1, pageSize: Int = 25, search: String, brandId: ID): ItemPage!
  # Barcode lookup: matches upc12 for 12-digit codes and upc14 for
  # 13/14-digit codes (13-digit EAN is left-padded to GTIN-14). Returns
  # null when nothing visible to the caller matches.
  itemByUpc(code: String!): Item
  # Admin-only: catalog items submitted by users awaiting approval.
  pendingItems(page: Int = 1, pageSize: Int = 25): ItemPage! @admin
  frequentItems(limit: Int = 10): [Item!]!
  ingredient(id: ID!): Ingredient
  ingredients(page: Int = 1, pageSize: Int = 25, search: String): IngredientPage!
  # The allergen registry — admin-curated; every entry a member can
  # record an allergy or dietary restriction against.
  allergens: [Allergen!]!
  # The caller's own allergy/dietary records.
  myAllergies: [MemberAllergen!]!
  # The allergen-flag suggestion review queue — AI-proposed flags an
  # admin accepts or dismisses. status filters to pending/accepted/
  # dismissed; unset returns the whole queue.
  allergenSuggestions(status: String): [AllergenSuggestion!]! @admin
  units: [Unit!]!
  recipe(id: ID!): Recipe
  scaledRecipe(id: ID!, servings: Int!): Recipe
  # The household's tweak-set audit log for a recipe, newest first
  # (LEN-58). Covers set/clear/acknowledge with before/after snapshots.
  recipeDeltaEvents(recipeId: ID!, limit: Int = 20): [RecipeDeltaEvent!]!
  recipes(page: Int = 1, pageSize: Int = 25, search: String, categoryIds: [ID!], isFavorite: Boolean, mealType: String, searchMode: RecipeSearchMode = keyword): RecipePage!
  recipeCategoryGroups: [RecipeCategoryGroup!]!
  recommendedRecipes(limit: Int = 10): [RecipeRecommendation!]!
  userItems(page: Int = 1, pageSize: Int = 25, search: String): UserItemPage!
  userBottles(page: Int = 1, pageSize: Int = 25, search: String): UserBottlePage!
  bottle(id: ID!): Bottle
  bottles(page: Int = 1, pageSize: Int = 25, search: String, countryId: ID, regionId: ID, typeId: ID, vintageYear: Int, favoritesOnly: Boolean): BottlePage!
  types: [WineType!]!
  countries: [Country!]!
  regions(countryId: ID!): [Region!]!
  vintages: [Vintage!]!
  grapeVarieties: [GrapeVariety!]!
  wineFlavorProfiles: [WineFlavorProfile!]!
  mealPlan(id: ID!): MealPlan
  mealPlans(page: Int = 1, pageSize: Int = 25): MealPlanPage!
  # Aggregated nutrition for a meal plan. Nutrient amounts are stored per
  # a declared basis (default: per 100 g of the item); consumed quantities
  # are converted into that basis before summing. Lines whose units cannot
  # be converted (e.g. incompatible kinds or missing net weight) are
  # skipped and reported in `warnings` instead of producing a wrong sum.
  nutrition(mealPlanId: ID!): MealPlanNutrition!
  groceryList(id: ID!): GroceryList
  groceryLists(page: Int = 1, pageSize: Int = 25): GroceryListPage!
  # Household stores for routing grocery lists through aisle layouts.
  groceryStores: [Store!]!
  # The authoritative walk order for a list — aisle groups in position
  # order, items sorted by manual rank then learned check-off order.
  groceryRouteGroups(groceryListId: ID!): [GroceryRouteGroup!]!
  # Pantry items at or below min_qty, ranked by household engagement and
  # excluding anything already on the latest grocery list.
  suggestedRestockItems(limit: Int = 10): [Item!]!
  # Admin-only: paged list of all registered users.
  users(page: Int = 1, pageSize: Int = 25): UserPage! @admin
  # Admin-only: a single recipe import job.
  recipeImport(id: ID!): RecipeImport @admin
  # Admin-only: paged list of recipe imports.
  recipeImports(page: Int = 1, pageSize: Int = 25, status: RecipeImportStatus): RecipeImportPage! @admin
  # Admin-only: pending recipe imports for review.
  pendingRecipeImports(page: Int = 1, pageSize: Int = 25): RecipeImportPage! @admin
  # The caller's household with its members; null when the caller has none.
  myHousehold: Household
  # Every household the caller belongs to — backs the household switcher.
  # Each entry carries the caller's role in that household and whether it
  # is their currently active one.
  myHouseholds: [Household!]!
  # Pending invites the caller received or sent (for cancellation).
  householdInvites: [HouseholdInvite!]!
  # Opted-in, active users matching a name/email term; excludes the
  # caller and current household members.
  searchHouseholdUsers(term: String!, limit: Int = 20): [HouseholdUser!]!
  # The caller's household notifications, newest first.
  myNotifications(limit: Int = 20): [HouseholdNotification!]!
  # Per-category notification preferences for the caller, including the
  # "_all" global-mute bucket. Missing pref rows report defaults.
  myNotificationPreferences: [NotificationCategoryPreference!]!
  # Unread notification count — backs the nav badge; clients poll it.
  unreadNotificationCount: Int!
  # The household's food events, newest event date first.
  foodEvents(page: Int = 1, pageSize: Int = 25): FoodEventPage!
  foodEvent(id: ID!): FoodEvent
  # Master timeline for an event: every recipe's steps backwards-scheduled
  # from their serve times, with missing-duration estimates and appliance
  # contention warnings. Computed on read.
  eventTimeline(foodEventId: ID!): EventTimeline
  # Whether the AI assistant is configured on this deployment — clients
  # hide AI entry points when false.
  aiAvailable: Boolean!
  # Whether recipe embeddings are configured — gates the semantic search
  # mode on the recipes query and the web toggle.
  semanticSearchAvailable: Boolean!
  # Ask the household assistant a question. The model may read household
  # data through its tools but can never write; errors UNAVAILABLE when no
  # provider is configured.
  askAssistant(question: String!): AssistantAnswer!
  # AI meal suggestions for a plan's open cells — stock, expiring items,
  # and household tastes inform the picks. Advisory only: apply with
  # addMealSlot. Errors UNAVAILABLE when no provider is configured.
  suggestMeals(mealPlanId: ID!, maxSuggestions: Int = 6): [MealPlanSuggestion!]!
  # AI fixes for an event timeline's appliance conflicts and unschedulable
  # dishes. Advisory only: apply via updateEventRecipe/updateEventRecipeStep.
  # Errors UNAVAILABLE when no provider is configured.
  suggestEventFixes(foodEventId: ID!, maxSuggestions: Int = 6): [EventFixSuggestion!]!
  # AI wine pairings for a recipe — cellar bottles plus style picks.
  # Requires a stored birthdate showing the caller is 21+.
  suggestPairings(recipeId: ID!, maxSuggestions: Int = 4): [PairingSuggestion!]!
  # AI cocktail ideas from the catalog's Cocktail dish type. With
  # inStockOnly, picks needing missing ingredients are dropped.
  # Requires a stored birthdate showing the caller is 21+.
  suggestCocktails(maxSuggestions: Int = 6, inStockOnly: Boolean = false): [CocktailSuggestion!]!
  # Read-only assistant tool catalog for client-side (on-device) agents —
  # the same specs the server provider is offered. Available even when no
  # server provider is configured.
  assistantTools: [AssistantToolSpec!]!
  # Execute one read-only assistant tool under the caller's household
  # scope for a client-side agent. Result is a JSON string; tool failures
  # arrive as {"error":...} payloads the client feeds back to the model.
  callAssistantTool(name: String!, arguments: String!): String!
  # Server-owned system prompt for a named assistant flow
  # (ask|suggest-meals|suggest-event-fixes|suggest-pairings|suggest-cocktails),
  # so on-device agents run identical prompts to the server path.
  assistantPrompt(name: String!): String!
  # Assemble a one-shot structured AI request server-side for client-side
  # generation — context gathered through the same read-only tools. Null
  # when nothing needs generating (e.g. a clean event timeline).
  prepareAssistantRequest(name: String!, paramsJson: String!): PreparedAIRequest
}

type Mutation {
  createBrand(input: CreateBrandInput!): Brand! @admin
  submitBrand(input: CreateBrandInput!): Brand!
  updateBrand(id: ID!, input: UpdateBrandInput!): Brand! @admin
  deleteBrand(id: ID!): Boolean! @admin
  approveBrand(id: ID!): Brand! @admin
  rejectBrand(id: ID!): Brand! @admin
  createCategory(input: CreateCategoryInput!): Category! @admin
  updateCategory(id: ID!, input: UpdateCategoryInput!): Category! @admin
  deleteCategory(id: ID!): Boolean! @admin
  createFlavorProfile(input: CreateFlavorProfileInput!): FlavorProfile! @admin
  updateFlavorProfile(id: ID!, input: UpdateFlavorProfileInput!): FlavorProfile! @admin
  deleteFlavorProfile(id: ID!): Boolean! @admin
  createNutrientType(input: CreateNutrientTypeInput!): NutrientType! @admin
  updateNutrientType(id: ID!, input: UpdateNutrientTypeInput!): NutrientType! @admin
  deleteNutrientType(id: ID!): Boolean! @admin
  createVintage(input: CreateVintageInput!): Vintage! @admin
  updateVintage(id: ID!, input: UpdateVintageInput!): Vintage! @admin
  deleteVintage(id: ID!): Boolean! @admin
  createGrapeVariety(input: CreateGrapeVarietyInput!): GrapeVariety! @admin
  updateGrapeVariety(id: ID!, input: UpdateGrapeVarietyInput!): GrapeVariety! @admin
  deleteGrapeVariety(id: ID!): Boolean! @admin
  createWineFlavorProfile(input: CreateWineFlavorProfileInput!): WineFlavorProfile! @admin
  updateWineFlavorProfile(id: ID!, input: UpdateWineFlavorProfileInput!): WineFlavorProfile! @admin
  deleteWineFlavorProfile(id: ID!): Boolean! @admin

  createCountry(input: CreateCountryInput!): Country! @admin
  updateCountry(id: ID!, input: UpdateCountryInput!): Country! @admin
  deleteCountry(id: ID!): Boolean! @admin
  createRegion(input: CreateRegionInput!): Region! @admin
  updateRegion(id: ID!, input: UpdateRegionInput!): Region! @admin
  deleteRegion(id: ID!): Boolean! @admin
  createType(input: CreateTypeInput!): WineType! @admin
  updateType(id: ID!, input: UpdateTypeInput!): WineType! @admin
  deleteType(id: ID!): Boolean! @admin

  createItem(input: CreateItemInput!): Item! @admin
  updateItem(id: ID!, input: UpdateItemInput!): Item!
  deleteItem(id: ID!): Boolean! @admin
  # Any authenticated user: submit a new catalog item in 'pending' status.
  # It is visible to (and editable by) the submitter until an admin approves
  # or rejects it.
  submitItem(input: CreateItemInput!): Item!
  # Admin-only moderation of user-submitted items. Rejected items are
  # hidden from everyone.
  approveItem(id: ID!): Item! @admin
  rejectItem(id: ID!): Item! @admin
  # Replace all nutrient values on an item atomically. Allowed for admins
  # and for the submitter while the item is still pending. This is the
  # single write path for nutrition data — the manual entry form and a
  # future label-scan/OCR pipeline both feed it.
  setItemNutrients(itemId: ID!, entries: [ItemNutrientEntryInput!]!): Item!
  # Kicks off server-side OCR + nutrient extraction in the background;
  # returns true once the job is queued, not once it finishes.
  submitItemNutritionPhoto(itemId: ID!, photoBase64: String!): Boolean!

  # Accepts a base64-encoded recipe scan from an admin, writes it to the
  # configured import inbox, and enqueues server-side OCR processing.
  submitRecipeScan(fileBase64: String!): RecipeImport! @admin
  # Admin-only: update recipe metadata and ingredient mappings for review.
  updateRecipeImport(id: ID!, input: RecipeImportReviewInput!): RecipeImport! @admin
  # Admin-only: persist an approved review as a catalog recipe.
  approveRecipeImport(id: ID!): Recipe! @admin
  # Admin-only: reject a recipe import.
  rejectRecipeImport(id: ID!): RecipeImport! @admin
  # Admin-only: retry a failed/profanity/rejected import.
  retryRecipeImport(id: ID!): RecipeImport! @admin

  createIngredient(input: CreateIngredientInput!): Ingredient! @admin
  updateIngredient(id: ID!, input: UpdateIngredientInput!): Ingredient! @admin
  deleteIngredient(id: ID!): Boolean! @admin
  # Free-create for members: returns the existing ingredient when the
  # normalized name already exists, so callers can't mint duplicates.
  getOrCreateIngredient(input: CreateIngredientInput!): Ingredient!
  # Admin dedupe tool: repoints every reference (recipes, meal slots,
  # events, grocery lines, aisle routes, item links, household prefs) from
  # fromId onto intoId, then deletes the source ingredient.
  mergeIngredient(fromId: ID!, intoId: ID!): Boolean! @admin
  # Admin: writes the catalog-level item -> ingredient link (null clears).
  setItemIngredient(itemId: ID!, ingredientId: ID): Boolean! @admin
  # Household remap — this item is a different ingredient for us (null
  # clears the override, restoring the catalog link).
  setHouseholdItemIngredient(itemId: ID!, ingredientId: ID): Boolean!
  # Brand-picked check-off: binds the chosen brand to an ingredient line,
  # checks it off, credits pantry stock, and records it as the usual brand.
  checkGroceryItemWithBrand(groceryListItemId: ID!, itemId: ID!): GroceryListItem!

  adjustUserItem(itemId: ID!, quantity: Float!, purchaseAt: Time, expiresAt: Time, minQty: Float): UserItem!
  setItemFavorite(itemId: ID!, isFavorite: Boolean!): UserItem!
  deleteUserItem(itemId: ID!): Boolean!
  incrementUserItem(itemId: ID!, delta: Float!): UserItem

  addFoodNutrient(input: AddFoodNutrientInput!): FoodNutrient!
  removeFoodNutrient(itemId: ID!, nutrientId: ID!): Boolean!
  addFoodFlavor(input: AddFoodFlavorInput!): FoodFlavor!
  removeFoodFlavor(itemId: ID!, flavorId: ID!): Boolean!

  createRecipe(input: CreateRecipeInput!): Recipe! @admin
  updateRecipe(id: ID!, input: CreateRecipeInput!): Recipe! @admin
  deleteRecipe(id: ID!): Boolean! @admin
  setRecipeFavorite(recipeId: ID!, isFavorite: Boolean!): Boolean!
  rateRecipe(recipeId: ID!, rating: Int!): Recipe!
  # Household recipe deltas — any member may write these.
  setRecipeDelta(recipeId: ID!, items: [RecipeDeltaItemInput!]!, steps: [RecipeDeltaStepInput!]!): RecipeDelta!
  clearRecipeDelta(recipeId: ID!): Boolean!
  acknowledgeRecipeDelta(recipeId: ID!): RecipeDelta!
  setRecipeCategories(recipeId: ID!, categoryIds: [ID!]!): Recipe! @admin
  createRecipeCategoryGroup(input: CreateRecipeCategoryGroupInput!): RecipeCategoryGroup! @admin
  updateRecipeCategoryGroup(id: ID!, input: UpdateRecipeCategoryGroupInput!): RecipeCategoryGroup! @admin
  deleteRecipeCategoryGroup(id: ID!): Boolean! @admin
  createRecipeCategory(input: CreateRecipeCategoryInput!): RecipeCategory! @admin
  updateRecipeCategory(id: ID!, input: UpdateRecipeCategoryInput!): RecipeCategory! @admin
  deleteRecipeCategory(id: ID!): Boolean! @admin

  createMealPlan(input: CreateMealPlanInput!): MealPlan!
  updateMealPlan(id: ID!, input: CreateMealPlanInput!): MealPlan!
  deleteMealPlan(id: ID!): Boolean!
  addMealSlot(input: AddMealSlotInput!): MealSlot!
  removeMealSlot(slotId: ID!): Boolean!
  addMealSlotItem(input: AddMealSlotItemInput!): MealSlotItem!
  removeMealSlotItem(slotItemId: ID!): Boolean!

  generateGroceryList(mealPlanId: ID!): GroceryList!
  recordSelection(entityType: EntityType!, entityId: ID!): Boolean!
  recordView(entityType: EntityType!, entityId: ID!): Boolean!
  recordSearch(entityType: EntityType!, term: String!): Boolean!
  toggleGroceryItemChecked(groceryListItemId: ID!): GroceryListItem!
  addGroceryItem(input: AddGroceryItemInput!): GroceryListItem!
  deleteGroceryItem(groceryListItemId: ID!): Boolean!

  createStore(name: String!): Store!
  renameStore(storeId: ID!, name: String!): Store!
  deleteStore(storeId: ID!): Boolean!
  createStoreAisle(storeId: ID!, name: String!, position: Int!): StoreAisle!
  renameStoreAisle(aisleId: ID!, name: String!): StoreAisle!
  deleteStoreAisle(aisleId: ID!): Boolean!
  reorderStoreAisles(storeId: ID!, aisleIds: [ID!]!): [StoreAisle!]!
  assignItemToAisle(storeId: ID!, aisleId: ID, itemId: ID, ingredientId: ID, manualItemName: String): Boolean!
  # Selects which store routes a list; null clears it.
  setGroceryListStore(groceryListId: ID!, storeId: ID): GroceryList!
  # Persists the user's arrangement — entries are the items in display
  # order; an entry carrying aisleId also moves the item to that aisle.
  reorderGroceryListItems(groceryListId: ID!, entries: [GroceryReorderEntryInput!]!): Boolean!

  createBottle(input: CreateBottleInput!): Bottle! @admin
  updateBottle(id: ID!, input: UpdateBottleInput!): Bottle! @admin
  deleteBottle(id: ID!): Boolean! @admin
  addBottleGrapeVariety(input: AddBottleGrapeVarietyInput!): BottleGrapeVariety! @admin
  removeBottleGrapeVariety(bottleId: ID!, grapeVarietyId: ID!): Boolean! @admin
  addBottleFlavorProfile(input: AddBottleFlavorProfileInput!): BottleFlavorProfile! @admin
  removeBottleFlavorProfile(bottleId: ID!, flavorProfileId: ID!): Boolean! @admin
  adjustUserBottle(bottleId: ID!, quantity: Int!): UserBottle!
  setBottleFavorite(bottleId: ID!, isFavorite: Boolean!): UserBottle!

  # Self-service profile update (first/last name, backup email).
  updateMyProfile(input: UpdateProfileInput!): User!
  # Admin-only user management. Rejects self-modification, protected
  # admins, and removing the last active admin.
  setUserRole(userId: ID!, role: Role!): User! @admin
  setUserActive(userId: ID!, isActive: Boolean!): User! @admin

  # Household membership: invite by user id, accept/decline received
  # invites, cancel sent ones, or leave the current household.
  inviteHouseholdMember(userId: ID!): HouseholdInvite!
  # Accepting adds a membership and activates the joined household. When
  # mergeFromHouseholdId names another household the caller solely owns,
  # its pantry/cellar/plans/lists/events move into the joined household
  # and the source household is dissolved.
  acceptHouseholdInvite(inviteId: ID!, mergeFromHouseholdId: ID): Household!
  declineHouseholdInvite(inviteId: ID!): HouseholdInvite!
  cancelHouseholdInvite(inviteId: ID!): HouseholdInvite!
  # Leaves the given household (default: the caller's active one). Owners
  # of multi-member households promote a successor first; leaving the
  # active household activates the caller's earliest remaining membership
  # or creates a fresh single-person household when none remain.
  leaveHousehold(householdId: ID): Boolean!
  # Creates a new household, joins the caller as owner, and activates it.
  createHousehold(name: String): Household!
  # Moves the caller's active-household pointer to a household they belong
  # to. All household-scoped reads and writes follow it.
  setActiveHousehold(householdId: ID!): Household!
  # Owner-only: set or clear the household's display name (empty clears).
  renameHousehold(name: String!): Household!
  # Owner-only: promote a member to admin or demote an admin to member.
  setHouseholdRole(userId: ID!, role: HouseholdRole!): Household!
  # Owner removes admins and members; admins remove members only.
  removeHouseholdMember(userId: ID!): Household!
  # Owner-only: hand ownership to another member; the caller becomes a
  # member.
  transferHouseholdOwnership(userId: ID!): Household!
  # Marks every unread notification read; returns whether any changed.
  markAllNotificationsRead: Boolean!
  # Turns a notification category on/off ("_all" toggles nothing extra --
  # global muting goes through muteNotifications instead).
  setNotificationCategoryEnabled(category: String!, enabled: Boolean!): Boolean!
  # Opts a category in/out of push delivery; "_all" is the master push
  # switch. Push is independent of the feed toggle.
  setNotificationCategoryPushEnabled(category: String!, enabled: Boolean!): Boolean!
  # Registers a push device token for the caller ("android"|"ios"|"web").
  # Idempotent; a token already owned by someone else is taken over.
  registerDeviceToken(token: String!, platform: String!): Boolean!
  # Removes one of the caller's own device tokens (logout). Removing a
  # token owned by someone else is a no-op.
  unregisterDeviceToken(token: String!): Boolean!
  # Mutes one category -- or every kind when category is null/"_all" --
  # until the given time.
  muteNotifications(category: String, until: Time!): Boolean!
  # Clears a mute window early; null/"_all" clears the global mute.
  clearNotificationMute(category: String): Boolean!
  # Adds an expiring pantry item as a replacement on the household's
  # current grocery list (most recently generated).
  addItemToCurrentGroceryList(itemId: ID!): GroceryListItem!
  # Runs the reminder sweep immediately; returns notifications created.
  # Admin/test hook -- the scheduler also sweeps hourly.
  triggerNotificationSweep: Int! @admin

  # Food events: household-scoped gatherings grouping recipes by serve
  # time. All members may create and edit.
  createFoodEvent(input: CreateFoodEventInput!): FoodEvent!
  updateFoodEvent(id: ID!, input: UpdateFoodEventInput!): FoodEvent!
  deleteFoodEvent(id: ID!): Boolean!
  addEventRecipe(input: AddEventRecipeInput!): EventRecipe!
  updateEventRecipe(id: ID!, input: UpdateEventRecipeInput!): EventRecipe!
  removeEventRecipe(id: ID!): Boolean!
  # Event recipe step/item mutations edit the slot's snapshots only —
  # never the shared recipe. syncEventRecipe re-copies the linked recipe's
  # steps, items, and base servings over the snapshots.
  addEventRecipeStep(eventRecipeId: ID!, input: EventRecipeStepInput!): EventRecipeStep!
  updateEventRecipeStep(id: ID!, input: EventRecipeStepInput!): EventRecipeStep!
  removeEventRecipeStep(id: ID!): Boolean!
  addEventRecipeItem(eventRecipeId: ID!, input: EventRecipeItemInput!): EventRecipeItem!
  updateEventRecipeItem(id: ID!, input: EventRecipeItemInput!): EventRecipeItem!
  removeEventRecipeItem(id: ID!): Boolean!
  syncEventRecipe(eventRecipeId: ID!): EventRecipe!
  # Records (on=true) or clears (on=false) one of the caller's
  # allergy/dietary records.
  setMyAllergy(allergenId: ID!, kind: MemberAllergyKind!, on: Boolean!): Boolean!
  createAllergen(input: CreateAllergenInput!): Allergen! @admin
  updateAllergen(id: ID!, input: UpdateAllergenInput!): Allergen! @admin
  # Admin curation of entity flags; null kind clears the flag.
  setIngredientAllergen(ingredientId: ID!, allergenId: ID!, kind: AllergenFlagKind): Boolean! @admin
  setItemAllergen(itemId: ID!, allergenId: ID!, kind: AllergenFlagKind): Boolean! @admin
  # Runs the AI flag suggester over one recipe and enqueues validated
  # proposals — nothing is applied until an admin accepts.
  suggestRecipeAllergens(recipeId: ID!, maxSuggestions: Int): [AllergenSuggestion!]! @admin
  # Writes the proposed flag under the reviewer's attribution.
  acceptAllergenSuggestion(id: ID!): AllergenSuggestion! @admin
  dismissAllergenSuggestion(id: ID!): AllergenSuggestion! @admin
}

input UpdateProfileInput {
  firstName: String
  lastName: String
  backupEmail: String
  # YYYY-MM-DD, or "" to clear. Unset leaves the stored value unchanged.
  birthdate: String
  isSearchable: Boolean
}

type PageInfo {
  pageNumber: Int!
  pageSize: Int!
  totalCount: Int!
}

type User {
  id: ID!
  email: String!
  displayName: String
  firstName: String
  lastName: String
  backupEmail: String
  # YYYY-MM-DD birthdate; gates sommelier/cocktail AI suggestions at 21+.
  birthdate: String
  role: Role!
  isActive: Boolean!
  # True when the user's email is in LENA_PROTECTED_EMAILS: such admins
  # can never be demoted or banned via the API.
  isProtected: Boolean!
  lastLoginAt: Time
  # Whether the user appears in household-invite search results.
  isSearchable: Boolean!
  # The user's household. Only resolves non-null when the resolved user
  # is the caller — admin user lists never expose household membership.
  household: Household
}

type UserPage {
  items: [User!]!
  pageInfo: PageInfo!
}

enum InviteStatus {
  PENDING
  ACCEPTED
  DECLINED
  CANCELLED
}

enum HouseholdRole {
  OWNER
  ADMIN
  MEMBER
}

enum NotificationKind {
  INVITE_RECEIVED
  INVITE_ACCEPTED
  INVITE_DECLINED
  INVITE_CANCELLED
  MEMBER_JOINED
  MEMBER_LEFT
  MEMBER_REMOVED
  ROLE_CHANGED
  HOUSEHOLD_RENAMED
  EVENT_CREATED
  EVENT_UPDATED
  EVENT_DELETED
  PROTEIN_DEFROST
  MEAL_PREP_ADVANCE
  ITEM_EXPIRING
}

# Restricted user projection for household flows — intentionally omits
# email, role, isProtected, and lastLoginAt, which the full User type
# returns unconditionally.
type HouseholdUser {
  id: ID!
  displayName: String
  firstName: String
  lastName: String
}

type Household {
  id: ID!
  name: String
  members: [HouseholdMember!]!
  # The caller's own role within this household.
  myRole: HouseholdRole!
  # Whether this is the caller's currently active household.
  isActive: Boolean!
  createdAt: Time!
}

# A member entry pairs the restricted user projection with household
# metadata. Role lives here rather than on HouseholdUser so invite/search
# results never expose which role a stranger holds in their household.
type HouseholdMember {
  user: HouseholdUser!
  role: HouseholdRole!
  isMe: Boolean!
}

type HouseholdNotification {
  id: ID!
  kind: NotificationKind!
  # The member whose action produced the event; null for system rows.
  actor: HouseholdUser
  # Deep-link target for event_* kinds; null otherwise or once the event
  # row is deleted (FK is ON DELETE SET NULL).
  foodEventId: ID
  # Server-rendered feed text for scheduled reminders; null on
  # event-driven rows, which clients render from kind.
  title: String
  body: String
  # Deep-link target for protein_defrost/meal_prep_advance reminders.
  recipeId: ID
  # Deep-link + action target for item_expiring reminders.
  itemId: ID
  createdAt: Time!
}

# One notification opt-out bucket as seen by the current user: a registry
# category (plus the synthetic "_all" global mute) with effective state.
type NotificationCategoryPreference {
  # "_all" is the global mute; every other value is a notification_type category.
  category: String!
  label: String!
  enabled: Boolean!
  # Whether push delivery is opted in for this category ("_all" is the
  # master push opt-in). Independent of `enabled` — a member can want a
  # category pushed but absent from the feed.
  pushEnabled: Boolean!
  mutedUntil: Time
}

type HouseholdInvite {
  id: ID!
  fromUser: HouseholdUser!
  toUser: HouseholdUser!
  status: InviteStatus!
  createdAt: Time!
}

type Category {
  id: ID!
  name: String!
  description: String
  isActive: Boolean!
  # Whether items in this category count as protein for defrost reminders.
  isProtein: Boolean!
}

type Brand {
  id: ID!
  name: String!
  selectionCount: Int!
  personalSelectionCount: Int!
  status: ModerationStatus!
  submittedByMe: Boolean!
}

type BrandPage {
  items: [Brand!]!
  pageInfo: PageInfo!
}

type FlavorProfile {
  id: ID!
  name: String!
  isActive: Boolean!
}

type NutrientType {
  id: ID!
  name: String!
  unit: String!
}

type FoodNutrient {
  nutrient: NutrientType!
  amount: Float!
}

type FoodFlavor {
  flavor: FlavorProfile!
  intensity: Int!
}

type Item {
  id: ID!
  name: String!
  brand: Brand
  upc12: String
  upc14: String
  category: Category!
  unit: String!
  nutrients: [FoodNutrient!]!
  flavors: [FoodFlavor!]!
  selectionCount: Int!
  personalSelectionCount: Int!
  # Catalog rows are approved; user submissions start pending until an
  # admin moderates them.
  status: ModerationStatus!
  # True when the current user submitted this (pending) item.
  submittedByMe: Boolean!
  netWeight: Float
  isMetric: Boolean!
  # Catalog-level generic ingredient this branded product is (global link).
  ingredient: Ingredient
  # Override-aware view: the household's remap when set, else the catalog
  # link. This is what stock rollups and recipe matching actually use.
  householdIngredient: Ingredient
  # Resolved allergen flags: the override-aware ingredient's flags unioned
  # with this product's own flags. Empty means "no allergen data" — not
  # "known safe".
  allergens: [AllergenFlag!]!
  # Household members whose allergy/dietary records conflict with this
  # item's allergen set.
  allergyWarnings: [AllergyWarning!]!
}

input ItemNutrientEntryInput {
  nutrientId: ID!
  amount: Float!
}

type ItemPage {
  items: [Item!]!
  pageInfo: PageInfo!
}

# Ingredient is a brand-agnostic generic ingredient ("all-purpose flour").
# Branded items exist for barcode scanning; recipes, meal slots and grocery
# lists reference ingredients so recipes don't require brand matches.
type Ingredient {
  id: ID!
  name: String!
  category: Category
  defaultUnit: String
  isActive: Boolean!
  # Canonical allergen flags for the ingredient. Empty means "no allergen
  # data" — not "known safe".
  allergens: [AllergenFlag!]!
  # Household members whose records conflict with this ingredient.
  allergyWarnings: [AllergyWarning!]!
}

# One allergen registry entry a member can record an allergy or dietary
# restriction against.
type Allergen {
  id: ID!
  name: String!
  description: String
  isActive: Boolean!
}

# One allergen flag on an entity — the union of the resolved ingredient's
# flags and any bound item's product-level flags; "contains" wins when
# both kinds appear for the same allergen.
type AllergenFlag {
  allergen: Allergen!
  kind: AllergenFlagKind!
}

# One member's allergy/dietary record — returned by myAllergies.
type MemberAllergen {
  allergen: Allergen!
  kind: MemberAllergyKind!
}

# One proposed flag in the review queue. Proposals are AI-generated and
# can be wrong in both directions — accepting writes the flag under the
# reviewer's attribution; dismissing keeps the audit trail.
type AllergenSuggestion {
  id: ID!
  recipeId: ID
  recipeName: String
  # "ingredient" or "item" — which id field identifies the flag target.
  targetKind: String!
  ingredientId: ID
  ingredientName: String
  itemId: ID
  itemName: String
  allergen: Allergen!
  kind: AllergenFlagKind!
  rationale: String
  status: String!
  reviewedAt: String
}

# A conflict between an entity's allergen set and one household member's
# records. member names the member; memberKind is their record kind;
# entityKind is the strongest flag the entity carries for that allergen.
type AllergyWarning {
  member: HouseholdUser!
  allergen: Allergen!
  memberKind: MemberAllergyKind!
  entityKind: AllergenFlagKind!
}

type IngredientPage {
  items: [Ingredient!]!
  pageInfo: PageInfo!
}

input CreateIngredientInput {
  name: String!
  categoryId: ID
  defaultUnit: String
}

input UpdateIngredientInput {
  name: String
  categoryId: ID
  defaultUnit: String
  isActive: Boolean
}

# Unit is a canonical unit of measure shared by every domain. kind is one
# of "volume", "weight", or "count" and enables future unit conversion.
# Unit inputs accept a name or abbreviation ("cup", "c"); unknown units
# are rejected.
type Unit {
  id: ID!
  name: String!
  abbreviation: String
  kind: String!
  isActive: Boolean!
  toBaseFactor: Float
}

type Recipe {
  id: ID!
  name: String!
  description: String
  servings: Int
  prepTimeMinutes: Int
  cookTimeMinutes: Int
  # view selects the household delta-applied (effective) rows or the
  # untouched canonical rows.
  items(view: RecipeView = effective): [RecipeItem!]!
  itemSections(view: RecipeView = effective): [RecipeItemSection!]!
  steps(view: RecipeView = effective): [RecipeStep!]!
  # The household's tweak set for this recipe — null when untouched.
  householdDelta: RecipeDelta
  isFavorite: Boolean!
  selectionCount: Int!
  personalSelectionCount: Int!
  myRating: Int
  averageRating: Float
  ratingCount: Int!
  categories: [RecipeCategory!]!
  # Union of every recipe line's resolved allergen flags. Empty means
  # "no allergen data" — not "known safe".
  allergens: [AllergenFlag!]!
  # Household members whose records conflict with this recipe.
  allergyWarnings: [AllergyWarning!]!
}

# RecipeCategoryGroup is a typed bucket of categories (Course, Cuisine,
# ...). An exclusive group allows at most one of its categories per recipe.
type RecipeCategoryGroup {
  id: ID!
  name: String!
  exclusive: Boolean!
  displayOrder: Int!
  categories: [RecipeCategory!]!
}

type RecipeCategory {
  id: ID!
  name: String!
  group: RecipeCategoryGroup!
}

type RecipeRecommendation {
  recipe: Recipe!
  reason: RecommendationReason!
  score: Float!
}

type RecipeItem {
  id: ID!
  item: Item
  ingredient: Ingredient
  quantity: Float!
  unit: String!
  section: String
  displayOrder: Int!
  notes: String
  isOptional: Boolean!
  # Null for untouched canonical lines; otherwise the delta kind that
  # produced this effective line (substitute, adjust, add — removed lines
  # never surface). Added lines carry id 0.
  deltaKind: String
}

# RecipeItemSection groups recipe items by section name (e.g. "For the
# crust"). Items without a section land in a group with a null name.
type RecipeItemSection {
  name: String
  items: [RecipeItem!]!
}

type RecipeStep {
  # Canonical step identity — household delta step rows anchor on it.
  # Added effective steps carry id 0.
  id: ID!
  stepNumber: Int!
  instruction: String!
  # Timing metadata feeding the future event-timeline scheduler; null
  # duration means the step's length is unknown.
  durationMinutes: Int
  stepType: String
  isPassive: Boolean!
  # Overrides the default previous-step dependency edge, by step number
  # within the same recipe.
  dependsOnStepNumber: Int
  # The resource the step occupies (e.g. "oven"), for contention-aware
  # scheduling.
  appliance: String
  # Null for untouched canonical steps; otherwise the delta kind that
  # produced this effective step (replace, add — removed steps never
  # surface). Added steps carry no base identity.
  deltaKind: String
}

# RecipeView selects between the household delta-applied rows and the
# untouched canonical recipe.
enum RecipeView {
  effective
  canonical
}

# A household's tweak set for one canonical recipe (LEN-25). One delta
# per recipe+household; stale fires when the canonical recipe changed
# after the delta was last written or acknowledged.
type RecipeDelta {
  id: ID!
  stale: Boolean!
  # Rows whose base line/step was deleted by a canonical edit — kept
  # around and flagged rather than silently dropped.
  orphanedItemCount: Int!
  orphanedStepCount: Int!
  items: [RecipeDeltaItem!]!
  steps: [RecipeDeltaStep!]!
  updatedAt: Time
}

# One ingredient-line change in a recipe delta.
type RecipeDeltaItem {
  id: ID!
  # Anchored base line — null for added lines and orphans.
  recipeItemId: ID
  kind: RecipeDeltaItemKind!
  item: Item
  ingredient: Ingredient
  quantity: Float
  unit: String
  # Unit identity — clients need it to round-trip a saved change set.
  unitId: ID
  section: String
  displayOrder: Int
  notes: String
  isOptional: Boolean
  # True when a canonical edit deleted the anchored line.
  orphaned: Boolean!
}

enum RecipeDeltaItemKind {
  substitute
  adjust
  remove
  add
}

# One step change in a recipe delta.
type RecipeDeltaStep {
  id: ID!
  # Anchored base step — null for added steps and orphans.
  stepId: ID
  kind: RecipeDeltaStepKind!
  stepNumber: Int
  instruction: String
  durationMinutes: Int
  stepType: String
  isPassive: Boolean
  dependsOnStepNumber: Int
  appliance: String
  orphaned: Boolean!
}

enum RecipeDeltaStepKind {
  replace
  remove
  add
}

# One audit row from a household's tweak history (LEN-58) — written on
# every set, clear, and acknowledge.
type RecipeDeltaEvent {
  id: ID!
  event: RecipeDeltaEventKind!
  # Email of the member who made the change.
  actor: String!
  # Tweaks in the event's "after" snapshot — or "before" on a clear.
  itemCount: Int!
  stepCount: Int!
  # Serialized {"before","after"} change-set snapshots, as a JSON string.
  detail: String!
  createdAt: Time!
}

enum RecipeDeltaEventKind {
  set
  clear
  acknowledge
}

# The whole-delta change set — replace-style writes send every change the
# household wants, and the service stores it verbatim.
input RecipeDeltaItemInput {
  recipeItemId: ID
  kind: RecipeDeltaItemKind!
  itemId: ID
  ingredientId: ID
  quantity: Float
  unitId: ID
  section: String
  displayOrder: Int
  notes: String
  isOptional: Boolean
}

input RecipeDeltaStepInput {
  stepId: ID
  kind: RecipeDeltaStepKind!
  stepNumber: Int
  instruction: String
  durationMinutes: Int
  stepType: String
  isPassive: Boolean
  dependsOnStepNumber: Int
  appliance: String
}

type RecipePage {
  items: [Recipe!]!
  pageInfo: PageInfo!
}

type Bottle {
  id: ID!
  typeId: ID!
  countryId: ID!
  regionId: ID!
  vineyard: String
  vintageYear: Int!
  abv: Float
  acidity: Int
  tanninLevel: Int
  body: Int
  sweetness: Int
  oakIntegration: Boolean
  bottleSize: String!
  grapeVarieties: [BottleGrapeVariety!]!
  flavorProfiles: [BottleFlavorProfile!]!
  selectionCount: Int!
  personalSelectionCount: Int!
}

type BottleGrapeVariety {
  grapeVariety: GrapeVariety!
  percentage: Int
}

type BottleFlavorProfile {
  flavorProfile: WineFlavorProfile!
  intensity: Int!
}

type WineFlavorProfile {
  id: ID!
  name: String!
  description: String
  isActive: Boolean!
}

type BottlePage {
  items: [Bottle!]!
  pageInfo: PageInfo!
}

type UserItem {
  id: ID!
  item: Item!
  currentQty: Float!
  minQty: Float
  purchaseAt: Time
  expiresAt: Time
  notes: String
  isFavorite: Boolean!
}

type UserItemPage {
  items: [UserItem!]!
  pageInfo: PageInfo!
}

type UserBottle {
  id: ID!
  bottle: Bottle!
  bottleNumber: Int
  quantity: Int!
  purchaseAt: Time
  purchasePrice: Float
  storageTemp: Float
  location: String
  notes: String
  isFavorite: Boolean!
}

type UserBottlePage {
  items: [UserBottle!]!
  pageInfo: PageInfo!
}

type MealPlan {
  id: ID!
  name: String!
  weekStartDate: String!
  isActive: Boolean!
  slots: [MealSlot!]!
}

type MealSlot {
  id: ID!
  dayOfWeek: Int!
  mealType: String!
  recipe: Recipe
  servings: Int
  replacementNote: String
  items: [MealSlotItem!]!
  # Union of the slot's own items' and the linked recipe's resolved
  # allergen flags. Empty means "no allergen data" — not "known safe".
  allergens: [AllergenFlag!]!
  # Household members whose records conflict with this slot's contents.
  allergyWarnings: [AllergyWarning!]!
}

type MealSlotItem {
  id: ID!
  item: Item
  ingredient: Ingredient
  quantity: Float!
  unit: String!
  isFromRecipe: Boolean!
}

type MealPlanPage {
  items: [MealPlan!]!
  pageInfo: PageInfo!
}

# FoodEvent is a household gathering (party, holiday meal) that groups
# recipes scheduled to be served at absolute times.
type FoodEvent {
  id: ID!
  name: String!
  eventDate: String!
  # Serve times must land on this boundary: 15 or 30 minutes.
  slotGranularityMinutes: Int!
  isActive: Boolean!
  recipes: [EventRecipe!]!
}

# EventRecipe assigns a recipe to a serve time within an event. recipe is
# null when the referenced recipe has been deleted. steps and items are
# the slot's own snapshots — edits here never touch the original recipe.
# baseServings freezes the recipe's servings at link time; scalingFactor
# is servings ÷ baseServings (1 when either is unset) and multiplies
# every snapshot item's quantity.
type EventRecipe {
  id: ID!
  mealType: String!
  targetTime: Time!
  servings: Int
  baseServings: Int
  scalingFactor: Float!
  notes: String
  recipe: Recipe
  steps: [EventRecipeStep!]!
  items: [EventRecipeItem!]!
  # Union of the slot snapshot's resolved allergen flags. Empty means
  # "no allergen data" — not "known safe".
  allergens: [AllergenFlag!]!
  # Household members whose records conflict with this slot's contents.
  allergyWarnings: [AllergyWarning!]!
}

# EventRecipeStep is one step in an event slot's recipe snapshot. It is
# copied from recipe_step when the slot is linked to a recipe; event
# mutations edit this copy only.
type EventRecipeStep {
  id: ID!
  stepNumber: Int!
  instruction: String!
  durationMinutes: Int
  stepType: String
  isPassive: Boolean!
  dependsOnStepNumber: Int
  appliance: String
}

# EventRecipeItem is one ingredient in an event slot's snapshot.
# quantity is already scaled by the slot's scalingFactor; baseQuantity is
# the per-base-servings amount copied from the recipe.
type EventRecipeItem {
  id: ID!
  item: Item
  ingredient: Ingredient
  quantity: Float!
  baseQuantity: Float!
  unit: String!
  section: String
  displayOrder: Int!
  notes: String
  isOptional: Boolean!
}

type FoodEventPage {
  items: [FoodEvent!]!
  pageInfo: PageInfo!
}

input CreateFoodEventInput {
  name: String!
  eventDate: String!
  slotGranularityMinutes: Int
}

input UpdateFoodEventInput {
  name: String
  eventDate: String
  slotGranularityMinutes: Int
  isActive: Boolean
}

input AddEventRecipeInput {
  foodEventId: ID!
  recipeId: ID
  mealType: String!
  targetTime: Time!
  servings: Int
  notes: String
}

input UpdateEventRecipeInput {
  recipeId: ID
  mealType: String
  targetTime: Time
  servings: Int
  notes: String
}

input EventRecipeStepInput {
  instruction: String!
  durationMinutes: Int
  stepType: String
  isPassive: Boolean
  dependsOnStepNumber: Int
  appliance: String
}

input EventRecipeItemInput {
  itemId: ID
  ingredientId: ID
  quantity: Float!
  unit: String!
  section: String
  displayOrder: Int
  notes: String
  isOptional: Boolean
}

# EventTimeline is the master schedule for a food event: each recipe's
# steps placed backwards from its targetTime. warnings carries event-level
# issues such as appliance contention between recipes.
type EventTimeline {
  foodEventId: ID!
  warnings: [String!]!
  recipes: [EventTimelineRecipe!]!
}

# EventTimelineRecipe is one event slot's computed schedule. startBy is
# the earliest moment work must begin; null when unschedulable.
type EventTimelineRecipe {
  eventRecipeId: ID!
  name: String!
  targetTime: Time!
  servings: Int
  baseServings: Int
  startBy: Time
  unschedulable: Boolean!
  warnings: [String!]!
  steps: [TimelineStep!]!
}

# TimelineStep is one recipe step placed on the timeline. scheduledMinutes
# is the effective slot time used (duration rounded up to the event's
# granularity); estimated marks a step that had no duration and was given
# one slot. conflicts lists appliance-contention messages.
type TimelineStep {
  stepNumber: Int!
  instruction: String!
  stepType: String
  isPassive: Boolean!
  appliance: String
  durationMinutes: Int
  scheduledMinutes: Int!
  estimated: Boolean!
  startTime: Time!
  endTime: Time!
  conflicts: [String!]!
}

type GroceryList {
  id: ID!
  generatedAt: Time!
  items: [GroceryListItem!]!
  store: Store
}

# A household-defined shopping location with its own aisle layout.
type Store {
  id: ID!
  name: String!
  aisles: [StoreAisle!]!
}

# One ordered section of a store's walk path.
type StoreAisle {
  id: ID!
  name: String!
  position: Int!
}

# A single stop's worth of items: an aisle group, or the trailing
# unassigned bucket when aisle is null.
type GroceryRouteGroup {
  aisle: StoreAisle
  items: [GroceryRouteItem!]!
}

type GroceryRouteItem {
  item: GroceryListItem!
  # True when the aisle placement came from learned-order inference rather
  # than an explicit assignment.
  suggested: Boolean!
}

input GroceryReorderEntryInput {
  groceryListItemId: ID!
  aisleId: ID
}

type GroceryListItem {
  id: ID!
  item: Item
  ingredient: Ingredient
  manualItemName: String
  quantityNeeded: Float!
  unitOfMeasure: String
  source: String!
  isChecked: Boolean!
  # The household's usual brand for this line's ingredient — recorded by
  # brand-picked check-offs. Null when the household has never picked one.
  usualBrand: Item
  # Resolved allergen flags for the line's ingredient and bound item.
  # Empty means "no allergen data" — not "known safe".
  allergens: [AllergenFlag!]!
  # Household members whose records conflict with this grocery line.
  allergyWarnings: [AllergyWarning!]!
}

input AddGroceryItemInput {
  groceryListId: ID!
  itemId: ID
  ingredientId: ID
  manualItemName: String
  quantity: Float!
  unit: String!
  source: String
}

type GroceryListPage {
  items: [GroceryList!]!
  pageInfo: PageInfo!
}

