scalar Time
scalar Date

type Query {
  me: User!
  brand(id: ID!): Brand
  brands: [Brand!]!
  category(id: ID!): Category
  categories: [Category!]!
  flavorProfiles: [FlavorProfile!]!
  nutrientTypes: [NutrientType!]!
  item(id: ID!): Item
  items(page: Int = 1, pageSize: Int = 25): ItemPage!
  recipe(id: ID!): Recipe
  recipes(page: Int = 1, pageSize: Int = 25): RecipePage!
  userItems(page: Int = 1, pageSize: Int = 25): UserItemPage!
  userBottles(page: Int = 1, pageSize: Int = 25): UserBottlePage!
  bottle(id: ID!): Bottle
  bottles(page: Int = 1, pageSize: Int = 25): BottlePage!
  types: [WineType!]!
  countries: [Country!]!
  regions(countryId: ID!): [Region!]!
  vintages: [Vintage!]!
  grapeVarieties: [GrapeVariety!]!
  wineFlavorProfiles: [WineFlavorProfile!]!
  mealPlan(id: ID!): MealPlan
  mealPlans(page: Int = 1, pageSize: Int = 25): MealPlanPage!
  nutrition(mealPlanId: ID!): [NutritionSummary!]!
  groceryList(id: ID!): GroceryList
  groceryLists(page: Int = 1, pageSize: Int = 25): GroceryListPage!
}

type Mutation {
  createBrand(input: CreateBrandInput!): Brand!
  updateBrand(id: ID!, input: UpdateBrandInput!): Brand!
  deleteBrand(id: ID!): Boolean!
  createCategory(input: CreateCategoryInput!): Category!
  updateCategory(id: ID!, input: UpdateCategoryInput!): Category!
  deleteCategory(id: ID!): Boolean!
  createFlavorProfile(input: CreateFlavorProfileInput!): FlavorProfile!
  updateFlavorProfile(id: ID!, input: UpdateFlavorProfileInput!): FlavorProfile!
  deleteFlavorProfile(id: ID!): Boolean!
  createNutrientType(input: CreateNutrientTypeInput!): NutrientType!
  updateNutrientType(id: ID!, input: UpdateNutrientTypeInput!): NutrientType!
  deleteNutrientType(id: ID!): Boolean!
  createVintage(input: CreateVintageInput!): Vintage!
  updateVintage(id: ID!, input: UpdateVintageInput!): Vintage!
  deleteVintage(id: ID!): Boolean!
  createGrapeVariety(input: CreateGrapeVarietyInput!): GrapeVariety!
  updateGrapeVariety(id: ID!, input: UpdateGrapeVarietyInput!): GrapeVariety!
  deleteGrapeVariety(id: ID!): Boolean!
  createWineFlavorProfile(input: CreateWineFlavorProfileInput!): WineFlavorProfile!
  updateWineFlavorProfile(id: ID!, input: UpdateWineFlavorProfileInput!): WineFlavorProfile!
  deleteWineFlavorProfile(id: ID!): Boolean!

  createCountry(input: CreateCountryInput!): Country!
  updateCountry(id: ID!, input: UpdateCountryInput!): Country!
  deleteCountry(id: ID!): Boolean!
  createRegion(input: CreateRegionInput!): Region!
  updateRegion(id: ID!, input: UpdateRegionInput!): Region!
  deleteRegion(id: ID!): Boolean!
  createType(input: CreateTypeInput!): WineType!
  updateType(id: ID!, input: UpdateTypeInput!): WineType!
  deleteType(id: ID!): Boolean!

  createItem(input: CreateItemInput!): Item!
  updateItem(id: ID!, input: UpdateItemInput!): Item!
  deleteItem(id: ID!): Boolean!

  adjustUserItem(itemId: ID!, quantity: Float!, purchaseAt: Time): UserItem!
  setItemFavorite(itemId: ID!, isFavorite: Boolean!): UserItem!
  deleteUserItem(itemId: ID!): Boolean!

  addFoodNutrient(input: AddFoodNutrientInput!): FoodNutrient!
  removeFoodNutrient(itemId: ID!, nutrientId: ID!): Boolean!
  addFoodFlavor(input: AddFoodFlavorInput!): FoodFlavor!
  removeFoodFlavor(itemId: ID!, flavorId: ID!): Boolean!

  createRecipe(input: CreateRecipeInput!): Recipe!
  updateRecipe(id: ID!, input: CreateRecipeInput!): Recipe!
  deleteRecipe(id: ID!): Boolean!
  setRecipeFavorite(recipeId: ID!, isFavorite: Boolean!): Boolean!

  createMealPlan(input: CreateMealPlanInput!): MealPlan!
  updateMealPlan(id: ID!, input: CreateMealPlanInput!): MealPlan!
  deleteMealPlan(id: ID!): Boolean!
  addMealSlot(input: AddMealSlotInput!): MealSlot!
  removeMealSlot(slotId: ID!): Boolean!
  addMealSlotItem(input: AddMealSlotItemInput!): MealSlotItem!
  removeMealSlotItem(slotItemId: ID!): Boolean!

  generateGroceryList(mealPlanId: ID!): GroceryList!
  toggleGroceryItemChecked(groceryListItemId: ID!): GroceryListItem!
  addGroceryItem(input: AddGroceryItemInput!): GroceryListItem!
  deleteGroceryItem(groceryListItemId: ID!): Boolean!

  createBottle(input: CreateBottleInput!): Bottle!
  updateBottle(id: ID!, input: UpdateBottleInput!): Bottle!
  deleteBottle(id: ID!): Boolean!
  addBottleGrapeVariety(input: AddBottleGrapeVarietyInput!): BottleGrapeVariety!
  removeBottleGrapeVariety(bottleId: ID!, grapeVarietyId: ID!): Boolean!
  addBottleFlavorProfile(input: AddBottleFlavorProfileInput!): BottleFlavorProfile!
  removeBottleFlavorProfile(bottleId: ID!, flavorProfileId: ID!): Boolean!
  adjustUserBottle(bottleId: ID!, quantity: Int!): UserBottle!
  setBottleFavorite(bottleId: ID!, isFavorite: Boolean!): UserBottle!
}

type PageInfo {
  pageNumber: Int!
  pageSize: Int!
  totalCount: Int!
}

type User {
  id: ID!
  email: String!
  displayName: String
}

type Category {
  id: ID!
  name: String!
  description: String
  isActive: Boolean!
}

type Brand {
  id: ID!
  name: String!
}

type FlavorProfile {
  id: ID!
  name: String!
  isActive: Boolean!
}

type NutrientType {
  id: ID!
  name: String!
  unit: String!
}

type FoodNutrient {
  nutrient: NutrientType!
  amount: Float!
}

type FoodFlavor {
  flavor: FlavorProfile!
  intensity: Int!
}

type Item {
  id: ID!
  name: String!
  brand: Brand
  upc12: String
  upc14: String
  category: Category!
  unit: String!
  nutrients: [FoodNutrient!]!
  flavors: [FoodFlavor!]!
}

type ItemPage {
  items: [Item!]!
  pageInfo: PageInfo!
}

type Recipe {
  id: ID!
  name: String!
  description: String
  servings: Int
  prepTimeMinutes: Int
  cookTimeMinutes: Int
  items: [RecipeItem!]!
  steps: [RecipeStep!]!
  isFavorite: Boolean!
}

type RecipeItem {
  item: Item!
  quantity: Float!
  unit: String!
  notes: String
  isOptional: Boolean!
}

type RecipeStep {
  stepNumber: Int!
  instruction: String!
}

type RecipePage {
  items: [Recipe!]!
  pageInfo: PageInfo!
}

type Bottle {
  id: ID!
  typeId: ID!
  countryId: ID!
  regionId: ID!
  vineyard: String
  vintageYear: Int!
  abv: Float
  acidity: Int
  tanninLevel: Int
  body: Int
  sweetness: Int
  oakIntegration: Boolean
  bottleSize: String!
  grapeVarieties: [BottleGrapeVariety!]!
  flavorProfiles: [BottleFlavorProfile!]!
}

type BottleGrapeVariety {
  grapeVariety: GrapeVariety!
  percentage: Int
}

type BottleFlavorProfile {
  flavorProfile: WineFlavorProfile!
  intensity: Int!
}

type WineFlavorProfile {
  id: ID!
  name: String!
  description: String
  isActive: Boolean!
}

type BottlePage {
  items: [Bottle!]!
  pageInfo: PageInfo!
}

type UserItem {
  id: ID!
  item: Item!
  currentQty: Float!
  minQty: Float
  purchaseAt: Time
  expiresAt: Time
  notes: String
  isFavorite: Boolean!
}

type UserItemPage {
  items: [UserItem!]!
  pageInfo: PageInfo!
}

type UserBottle {
  id: ID!
  bottle: Bottle!
  bottleNumber: Int
  quantity: Int!
  purchaseAt: Time
  purchasePrice: Float
  storageTemp: Float
  location: String
  notes: String
  isFavorite: Boolean!
}

type UserBottlePage {
  items: [UserBottle!]!
  pageInfo: PageInfo!
}

type MealPlan {
  id: ID!
  name: String!
  weekStartDate: String!
  isActive: Boolean!
  slots: [MealSlot!]!
}

type MealSlot {
  id: ID!
  dayOfWeek: Int!
  mealType: String!
  recipe: Recipe
  servings: Int
  replacementNote: String
  items: [MealSlotItem!]!
}

type MealSlotItem {
  id: ID!
  item: Item
  quantity: Float!
  unit: String!
  isFromRecipe: Boolean!
}

type MealPlanPage {
  items: [MealPlan!]!
  pageInfo: PageInfo!
}

type GroceryList {
  id: ID!
  generatedAt: Time!
  items: [GroceryListItem!]!
}

type GroceryListItem {
  id: ID!
  item: Item
  manualItemName: String
  quantityNeeded: Float!
  unitOfMeasure: String
  source: String!
  isChecked: Boolean!
}

input AddGroceryItemInput {
  groceryListId: ID!
  itemId: ID
  manualItemName: String
  quantity: Float!
  unit: String!
}

type GroceryListPage {
  items: [GroceryList!]!
  pageInfo: PageInfo!
}

input CreateBrandInput {
  name: String!
}

input CreateCategoryInput {
  name: String!
  description: String
}

input CreateFlavorProfileInput {
  name: String!
}

input CreateNutrientTypeInput {
  name: String!
  unit: String!
}

input CreateVintageInput {
  year: Int!
  description: String
}

input CreateGrapeVarietyInput {
  name: String!
  description: String
}

input UpdateBrandInput {
  name: String!
}

input UpdateCategoryInput {
  name: String
  description: String
  isActive: Boolean
}

input UpdateFlavorProfileInput {
  name: String
  isActive: Boolean
}

input UpdateNutrientTypeInput {
  name: String
  unit: String
}

input UpdateVintageInput {
  year: Int
  description: String
  isActive: Boolean
}

input UpdateGrapeVarietyInput {
  name: String
  description: String
  isActive: Boolean
}

input CreateWineFlavorProfileInput {
  name: String!
  description: String
}

input UpdateWineFlavorProfileInput {
  name: String
  description: String
  isActive: Boolean
}

input CreateCountryInput {
  name: String!
  isoCode: String!
  description: String
}

input UpdateCountryInput {
  name: String
  isoCode: String
  description: String
  isActive: Boolean
}

input CreateRegionInput {
  countryId: ID!
  name: String!
  description: String
}

input UpdateRegionInput {
  countryId: ID
  name: String
  description: String
  isActive: Boolean
}

input CreateTypeInput {
  name: String!
  description: String
}

input UpdateTypeInput {
  name: String
  description: String
  isActive: Boolean
}

input AddFoodNutrientInput {
  itemId: ID!
  nutrientId: ID!
  amount: Float!
}

input AddFoodFlavorInput {
  itemId: ID!
  flavorId: ID!
  intensity: Int!
}

input CreateItemInput {
  name: String!
  brandId: ID
  upc12: String
  upc14: String
  categoryId: ID!
  unit: String!
}

input CreateRecipeInput {
  name: String!
  description: String
  servings: Int
  prepTimeMinutes: Int
  cookTimeMinutes: Int
  items: [RecipeItemInput!]!
  steps: [RecipeStepInput!]!
}

input RecipeItemInput {
  itemId: ID!
  quantity: Float!
  unit: String!
  notes: String
  isOptional: Boolean
}

input RecipeStepInput {
  stepNumber: Int!
  instruction: String!
}

input UpdateItemInput {
  name: String
  brandId: ID
  upc12: String
  upc14: String
  categoryId: ID
  unit: String
}

input CreateMealPlanInput {
  name: String!
  weekStartDate: String!
  weekStartDayOfWeek: Int
}

input AddMealSlotInput {
  mealPlanId: ID!
  dayOfWeek: Int!
  mealType: String!
  recipeId: ID
  servings: Int
  replacementNote: String
}

input AddMealSlotItemInput {
  slotId: ID!
  itemId: ID!
  quantity: Float!
  unit: String!
  isFromRecipe: Boolean
}

type WineType {
  id: ID!
  name: String!
  description: String
}

type Country {
  id: ID!
  name: String!
  isoCode: String
  description: String
}

type Region {
  id: ID!
  name: String!
  description: String
  country: Country!
}

type Vintage {
  id: ID!
  year: Int!
  description: String
  isActive: Boolean!
}

type GrapeVariety {
  id: ID!
  name: String!
  description: String
  isActive: Boolean!
}

type NutritionSummary {
  name: String!
  unit: String!
  amount: Float!
}

input CreateBottleInput {
  typeId: ID!
  countryId: ID!
  regionId: ID!
  vintageYear: Int!
  vineyard: String
  abv: Float
  acidity: Int
  tanninLevel: Int
  body: Int
  sweetness: Int
  oakIntegration: Boolean
  bottleSize: String!
}

input UpdateBottleInput {
  typeId: ID
  countryId: ID
  regionId: ID
  vintageYear: Int
  vineyard: String
  abv: Float
  acidity: Int
  tanninLevel: Int
  body: Int
  sweetness: Int
  oakIntegration: Boolean
  bottleSize: String
}

input AddBottleGrapeVarietyInput {
  bottleId: ID!
  grapeVarietyId: ID!
  percentage: Int
}

input AddBottleFlavorProfileInput {
  bottleId: ID!
  flavorProfileId: ID!
  intensity: Int!
}
