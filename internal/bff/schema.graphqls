# One assistant reply: the final text plus the household-data lookups it
# made (the "checked your pantry" trace).
type AssistantAnswer {
  answer: String!
  toolCalls: [AssistantToolCall!]!
}

# One tool invocation the assistant made while answering.
type AssistantToolCall {
  name: String!
}

# One read-only assistant tool spec for a client-side agent.
type AssistantToolSpec {
  # Tool name the model invokes (e.g. "get_pantry_inventory").
  name: String!
  # Human/model-facing purpose text.
  description: String!
  # JSON Schema for the tool's arguments, as a JSON string.
  parametersJson: String!
}

# A fully assembled one-shot AI request for client-side inference: system
# prompt, assembled context message, and the required output contract.
type PreparedAIRequest {
  # System prompt.
  prompt: String!
  # Assembled user message, as a JSON string.
  contextJson: String!
  # JSON Schema the model output must satisfy, as a JSON string.
  outputSchemaJson: String!
}

# One AI meal suggestion for an open dayOfWeek/mealType cell — reviewable
# before applying via addMealSlot.
type MealPlanSuggestion {
  recipe: Recipe!
  dayOfWeek: Int!
  mealType: String!
  # Why the model picked it ("uses expiring milk", "household favorite").
  reason: String!
  # Expiring pantry items the recipe would consume.
  usesExpiringItems: [String!]!
}

# One AI wine pairing for a recipe. bottleId/inCellar identify a bottle
# from the household cellar; when null the name is a style suggestion.
type PairingSuggestion {
  bottleId: ID
  name: String!
  reason: String!
  inCellar: Boolean!
}

# One AI cocktail pick — a catalog recipe tagged with the Cocktail dish
# type. missingIngredients lists pantry gaps the model identified.
type CocktailSuggestion {
  recipe: Recipe!
  reason: String!
  missingIngredients: [String!]!
}

# One AI schedule fix for an event timeline problem. The action field
# selects which payload fields are meaningful:
#   shift_serve     → minutes (signed, multiple of the event granularity)
#   set_appliance   → stepNumber + appliance
#   set_duration    → stepNumber + durationMinutes
#   set_dependency  → stepNumber + dependsOnStepNumber
# Applied via updateEventRecipe / updateEventRecipeStep.
type EventFixSuggestion {
  eventRecipeId: ID!
  recipeName: String!
  stepNumber: Int
  action: String!
  minutes: Int
  appliance: String
  durationMinutes: Int
  dependsOnStepNumber: Int
  reason: String!
}
