# Base URL for the LENA API. Default /graphql (same origin — Caddy routes
# /graphql and /auth/* to the api service in the compose stack). For a
# bare `npm run dev` against a directly-run API use http://localhost:8080.
NEXT_PUBLIC_API_BASE_URL=/graphql

# Google OAuth client ID — must match the audience in LENA_AUTH_AUDIENCES.
NEXT_PUBLIC_GOOGLE_CLIENT_ID=__YOUR_GOOGLE_CLIENT_ID__

# Optional OAuth2 sign-in providers (buttons appear only when the public
# client id is set; the server still needs the matching LENA_*_CLIENT_SECRET).
# NEXT_PUBLIC_DISCORD_CLIENT_ID=
# NEXT_PUBLIC_DISCORD_REDIRECT_URI=http://localhost/auth/discord/callback
# NEXT_PUBLIC_MICROSOFT_CLIENT_ID=
# NEXT_PUBLIC_MICROSOFT_TENANT=consumers
# NEXT_PUBLIC_MICROSOFT_REDIRECT_URI=http://localhost/auth/microsoft/callback
# NEXT_PUBLIC_FACEBOOK_CLIENT_ID=
# NEXT_PUBLIC_FACEBOOK_REDIRECT_URI=http://localhost/auth/facebook/callback
